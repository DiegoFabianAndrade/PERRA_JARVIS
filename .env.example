# ========================================================
# CONFIGURACIÓN GENERAL - PERRA_JARVIS
# ========================================================
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
ALLOWED_CHAT_ID=1257398092
GEMINI_API_KEY=tu_api_key_de_gemini_gratis_aqui
ASSISTANT_NAME=PERRA_JARVIS
DEBUG=False

# ========================================================
# 📧 GMAIL (IMAP Seguro)
# ========================================================
# Requiere tener activa la Verificación en 2 pasos en tu cuenta de Google.
# Luego busca "Contraseñas de aplicaciones" en https://myaccount.google.com
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ========================================================
# 📅 CALENDARIOS (iPhone iCloud & Google Calendar)
# ========================================================
# Enlace público/privado Webcal (.ics) de iCloud
ICLOUD_CALENDAR_URL=https://pXX-caldav.icloud.com/published/...o_enlace_ics

# Dirección secreta en formato iCal de Google Calendar (calendar.google.com -> Configuración -> Dirección secreta en formato iCal)
GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Azure Storage Persistente (Costo $0.00)
AZURE_STORAGE_CONN=DefaultEndpointsProtocol=https;...
AZURE_BLOB_SAS_URL=https://<storage_account>.blob.core.windows.net/jarvis-state
AZURE_BLOB_SAS_QUERY=<sas_token>
